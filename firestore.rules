rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'vigneshsivan2001@gmail.com' && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Health check / test connection
    match /test/connection {
      allow read: if true;
    }

    // Global Website Settings (General contact info, social handles, images, achievements)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Brownie Menu Items
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Baking Classes & Times
    match /baking_classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        incoming().uid == userId &&
        incoming().email == request.auth.token.email &&
        incoming().keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'role', 'createdAt', 'favorites']) &&
        incoming().keys().hasAll(['uid', 'email']) &&
        (incoming().role == 'customer' || (incoming().role == 'admin' && isAdmin())) &&
        (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 100)) &&
        (!('photoURL' in incoming()) || (incoming().photoURL is string && incoming().photoURL.size() <= 500));

      allow update: if (isOwner(userId) || isAdmin()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'favorites', 'role']) &&
        (incoming().role == existing().role || isAdmin());

      allow delete: if isAdmin();
    }

    // Class Registrations Collection
    match /class_registrations/{registrationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(registrationId) &&
        incoming().userId == request.auth.uid &&
        incoming().keys().hasOnly(['userId', 'userEmail', 'userName', 'className', 'preferredDate', 'notes', 'status', 'createdAt']) &&
        incoming().keys().hasAll(['userId', 'userEmail', 'className', 'status', 'createdAt']) &&
        incoming().className is string && incoming().className.size() <= 150 &&
        incoming().status in ['registered', 'waitlist', 'cancelled'];

      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes']))
      );

      allow delete: if isAdmin();
    }

    // Inquiries Collection
    match /inquiries/{inquiryId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(inquiryId) &&
        incoming().userId == request.auth.uid &&
        incoming().keys().hasOnly(['userId', 'userEmail', 'userName', 'subject', 'message', 'status', 'createdAt']) &&
        incoming().keys().hasAll(['userId', 'userEmail', 'subject', 'message', 'status', 'createdAt']) &&
        incoming().subject is string && incoming().subject.size() <= 200 &&
        incoming().message is string && incoming().message.size() <= 1000 &&
        incoming().status in ['new', 'replied', 'closed'];

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
